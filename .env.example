# Copy to .env and adjust only if needed.
# Default ports are standard HTTPS/HTTP.
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# AdGuard Home
# DNS listener on the Docker host (53/tcp + 53/udp).
ADGUARD_DNS_PORT=53
# Initial AdGuard setup UI is served from container port 3000.
ADGUARD_ADMIN_PORT=3001
# Main AdGuard UI after setup (container port 80).
ADGUARD_WEB_PORT=3080
