# Copy to .env and adjust only if needed.
# Default ports are standard HTTPS/HTTP.
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
# External Docker network that the Groovenet app stack joins.
# Set this to the live Compose network name before starting Caddy.
GROOVENET_DOCKER_NETWORK=dj-playlist_default
# Upstream hostname on that shared network. Production uses `myapp`.
GROOVENET_UPSTREAM_HOST=myapp

# Shared timezone for containers that support it.
TZ=America/Los_Angeles

# AdGuard Home
# DNS listener on the Docker host (53/tcp + 53/udp).
ADGUARD_DNS_PORT=53
# Initial AdGuard setup UI is served from container port 3000.
ADGUARD_ADMIN_PORT=3001
# Main AdGuard UI after setup (container port 80).
ADGUARD_WEB_PORT=3080

# Immich
IMMICH_VERSION=v2.7.5
IMMICH_UPLOAD_LOCATION=./data/immich/library
IMMICH_DB_DATA_LOCATION=./data/immich/postgres
# Use only A-Za-z0-9 for the password.
IMMICH_DB_PASSWORD=changeMe1234567890
IMMICH_DB_HOSTNAME=immich-database
IMMICH_DB_PORT=5432
IMMICH_DB_USERNAME=postgres
IMMICH_DB_DATABASE_NAME=immich
IMMICH_REDIS_HOSTNAME=immich-redis
IMMICH_REDIS_PORT=6379
