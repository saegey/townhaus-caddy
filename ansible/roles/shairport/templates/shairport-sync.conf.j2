// Managed by Ansible – edit in ansible/roles/shairport/templates/ in the monorepo.

general = {
  name = "{{ shairport_name }}";
  interpolation = "soxr";
  output_backend = "alsa";
  // SMSL DAC is fixed line-level with no hardware volume control, and the amp
  // has a physical volume knob. Attenuating in software here would only lower
  // the signal before the DAC while its analog noise floor and the fixed amp
  // gain stay put, raising audible hiss. So pass bit-perfect 0 dBFS to the DAC
  // and control loudness at the amp.
  ignore_volume_control = "yes";
  volume_max_db = 0.0;
};

alsa = {
  output_device = "{{ shairport_alsa_output }}";
};

mqtt = {
  enabled = "yes";
  hostname = "{{ mqtt_host }}";
  port = {{ mqtt_port }};
  topic = "{{ shairport_mqtt_topic }}";
  username = "{{ shairport_mqtt_user }}";
  password = "{{ shairport_mqtt_pass }}";
  publish_parsed = "{{ shairport_mqtt_publish_parsed | default('no') }}";
  publish_cover = "{{ shairport_mqtt_publish_cover | default('no') }}";
{% if shairport_mqtt_enable_remote is defined %}
  enable_remote = "{{ shairport_mqtt_enable_remote }}";
{% endif %}
};

metadata = {
  enabled = "{{ shairport_metadata_enabled }}";
  include_cover_art = "{{ shairport_effective_metadata_include_cover_art }}";
};

diagnostics = {
  log_verbosity = 1;
};
