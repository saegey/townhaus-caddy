[Unit]
Description=Back up Immich to Backblaze B2
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
EnvironmentFile=/etc/immich-backup/environment
ExecStart=/usr/local/sbin/immich-backup
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=infinity
