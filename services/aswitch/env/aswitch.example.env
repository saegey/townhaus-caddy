# Copy to env/aswitch.env and set real values before deploy.

MQTT_HOST=homeassistant.local
MQTT_PORT=1883
MQTT_USER=your-user
MQTT_PASS=your-password
LOG_LEVEL=INFO

# aswitch.py doesn't require extra env keys beyond MQTT.

# audio_activity.py
AUDIO_DEVICE=plughw:CARD=CODEC,DEV=0
RECORDINGS_DIR=/home/YOUR_USER/aswitch/recordings
RECORDING_ATTENUATION_DB=-6.0

# ir_logger.py
IR_GPIO=17
IR_TX_GPIO=18
IR_FRAME_GAP_US=15000
IR_GLITCH_FILTER_US=100
IR_TOPIC_RECEIVED=aswitch/ir/received
IR_TOPIC_AVAILABILITY=aswitch/ir/availability
IR_TOPIC_SEND=aswitch/ir/send
IR_TOPIC_SENT=aswitch/ir/sent
IR_TX_FREQUENCY_HZ=38000
IR_TX_REPEAT_COUNT=1
