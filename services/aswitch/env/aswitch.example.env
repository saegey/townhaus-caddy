# Copy to env/aswitch.env and set real values before deploy.

MQTT_HOST=homeassistant.local
MQTT_PORT=1883
MQTT_USER=your-user
MQTT_PASS=your-password
LOG_LEVEL=INFO

# aswitch.py doesn't require extra env keys beyond MQTT.

# audio_activity.py
AUDIO_DEVICE=plughw:CARD=CODEC,DEV=0
RECORDINGS_DIR=/home/YOUR_USER/aswitch/recordings
RECORDING_ATTENUATION_DB=-6.0

# ir_logger.py
IR_GPIO=17
IR_TX_GPIO=18
IR_FRAME_GAP_US=15000
IR_GLITCH_FILTER_US=100
IR_TOPIC_RECEIVED=aswitch/ir/received
IR_TOPIC_AVAILABILITY=aswitch/ir/availability
IR_TOPIC_SEND=aswitch/ir/send
IR_TOPIC_SENT=aswitch/ir/sent
IR_TX_FREQUENCY_HZ=38000
IR_TX_REPEAT_COUNT=1

# preamp_trigger.py — HY-M154 channel 1 / preamp 12V trigger sense
PREAMP_TRIGGER_GPIO=23
PREAMP_TRIGGER_GLITCH_FILTER_US=20000
PREAMP_TRIGGER_STATE_TOPIC=aswitch/preamp/trigger/state
PREAMP_TRIGGER_AVAILABILITY_TOPIC=aswitch/preamp/trigger/availability

# preamp_led.py — TCS34725 preamp LED monitor
TCS34725_I2C_BUS=1
TCS34725_I2C_ADDRESS=0x29
TCS34725_INTEGRATION_TIME=0xD6
TCS34725_GAIN=0x01
PREAMP_LED_SAMPLE_INTERVAL_SECONDS=1
PREAMP_LED_OFF_CLEAR_THRESHOLD=10
PREAMP_LED_COLOR_DOMINANCE_RATIO=1.5
PREAMP_INPUT_BLUE_STATE=input_1
PREAMP_INPUT_RED_STATE=input_2
PREAMP_LED_STATE_TOPIC=aswitch/preamp/led/state
PREAMP_INPUT_STATE_TOPIC=aswitch/preamp/input/state
PREAMP_LED_RGB_TOPIC=aswitch/preamp/led/rgb
PREAMP_LED_AVAILABILITY_TOPIC=aswitch/preamp/led/availability
