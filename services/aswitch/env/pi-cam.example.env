# Copy to env/pi-cam.env and set real values before deploy.
# pi-cam runs the DAC status monitor and amp trigger relay — no audio recording.

MQTT_HOST=homeassistant.local
MQTT_PORT=1883
MQTT_USER=your-user
MQTT_PASS=your-password
LOG_LEVEL=INFO

# dac_status.py
DAC_USB_ID=your-usb-vendor:product-id
DAC_MATCH_TEXT=Your DAC Name
DAC_POLL_INTERVAL_SECONDS=5
DAC_STATE_TOPIC=aswitch/dac/your-dac/state
DAC_DETAILS_TOPIC=aswitch/dac/your-dac/details
DAC_AVAILABILITY_TOPIC=aswitch/dac/your-dac/availability

# amp_trigger.py — BCM GPIO27 is physical header pin 13.
AMP_TRIGGER_GPIO=27
AMP_TRIGGER_COMMAND_TOPIC=pi-cam/trigger
AMP_TRIGGER_STATE_TOPIC=pi-cam/trigger/state
AMP_TRIGGER_AVAILABILITY_TOPIC=pi-cam/availability
