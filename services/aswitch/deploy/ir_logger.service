[Unit]
Description=IR logger MQTT publisher
After=network-online.target pigpiod.service
Wants=network-online.target pigpiod.service

[Service]
Type=simple
User=__ASWITCH_USER__
WorkingDirectory=__ASWITCH_REMOTE_DIR__
EnvironmentFile=-__ASWITCH_REMOTE_DIR__/.env
ExecStart=__ASWITCH_REMOTE_DIR__/.venv/bin/python __ASWITCH_REMOTE_DIR__/ir_logger.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
