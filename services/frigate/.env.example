# Timezone used inside container.
TZ=America/Los_Angeles

# Container runtime user/group (set to your host user if needed).
PUID=1000
PGID=1000

# External MQTT broker in Home Assistant environment.
FRIGATE_MQTT_HOST=192.168.1.10
FRIGATE_MQTT_PORT=1883
FRIGATE_MQTT_USER=frigate
FRIGATE_MQTT_PASSWORD=change_me
FRIGATE_MQTT_TOPIC_PREFIX=frigate

# Full RTSP URL used by go2rtc for the doorbell camera.
# If your password has special chars (@ : / ? # & %), URL-encode it.
# Example password `p@ss:word#1` => `p%40ss%3Aword%231`
FRIGATE_DOORBELL_RTSP_URL=rtsp://admin:replace_me@192.168.2.137:554/Preview_01_main

# Main and sub RTSP streams for the Oficina camera at 192.168.2.138.
FRIGATE_OFICINA_RTSP_URL=rtsp://admin:replace_me@192.168.2.138:554/Preview_01_main
FRIGATE_OFICINA_RTSP_SUB_URL=rtsp://admin:replace_me@192.168.2.138:554/Preview_01_sub

# HomeKit PIN for go2rtc exported camera accessory (8 digits).
FRIGATE_HOMEKIT_PIN=19550224
